# Copiar a supabase/functions/.env (no se sube al repo). Valores locales de ejemplo.
POS_MODE=mock
# Solo local: habilita las funciones dev-* que simulan la tablet y la caja. NUNCA en producción.
DEV_ENDPOINTS=true
POS_BASE_URL=
POS_HMAC_SECRET=dev-secret-fidelizacion-a-pos
POS_INBOUND_HMAC_SECRET=dev-secret-pos-a-fidelizacion

# Secreto de la tarea programada que llama a la función reconcile
RECONCILE_SECRET=dev-secret-reconcile
